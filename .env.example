# Neon Postgres (set automatically by the Vercel <-> Neon integration)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# First administrator, created automatically on the first request when the users table is empty.
# Required. Use a strong password (min. 8 characters) and change it after the first login.
ADMIN_PASSWORD="choose-a-strong-password"
# Optional (defaults: username "admin", name "مدیر سامانه")
ADMIN_USERNAME="admin"
ADMIN_FULL_NAME=""

# Development only. NEVER enable in production: exposes /api/dev/* (reset database / seed demo data).
# ENABLE_DEV_TOOLS="true"
# Vite (frontend) flag to show the test panel and demo accounts in a production build:
# VITE_ENABLE_DEV_TOOLS="true"
